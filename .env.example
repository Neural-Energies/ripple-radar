# Optional. Without it, "Analyze this event" uses the local engine (composeFromText).
XAI_API_KEY=

# Model routing (v0). Set to 1 to pick analyze/rescore models with route();
# unset uses grok-4.5. Entitlement and the per-account allowance apply either way.
# RIPPLE_MODEL_ROUTING=1

# Optional logical model ids (default grok-4.5 for both until a cheap SKU exists).
# RIPPLE_MODEL_CHEAP=grok-4.5
# RIPPLE_MODEL_DEEP=grok-4.5

# Optional. FRED+ALFRED delayed macro (CPIAUCSL, UNRATE, VIXCLS, DCOILWTICO, T10Y2Y, DGS10).
# Without it, the desk skips official-stat series (empty bundle, no throw) and stays on RSS + Yahoo.
# Request a key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Auth + durable desk sync (Better Auth + Postgres). Leave unset for local/PWA demo.
# DATABASE_URL=postgres://user:pass@host/db
# BETTER_AUTH_SECRET=
# VITE_AUTH_ENABLED=true

# Paid compute (Analyze / Rescore with the model). Signed-in accounts with an
# active or trialing row in `entitlements` (unexpired current_period_end), and
# operators. The Stripe webhook writes that table; without billing configured,
# grant a plan directly:
#   insert into entitlements (user_id, plan, status, current_period_end)
#   values ('<user id>', 'desk', 'active', now() + interval '30 days');
# Operators (comma-separated user ids) always have paid access and are the only
# accounts that may run forecast resolution.
# OPERATOR_USER_IDS=

# Billing (Stripe). All three set = the Subscribe/Plan control appears and
# /api/billing/webhook accepts signed events. In the Stripe dashboard: one
# recurring price, a webhook endpoint at https://<host>/api/billing/webhook
# sending checkout.session.completed, customer.subscription.created/updated/
# deleted and charge.refunded, and the Customer Portal enabled (cancel, payment
# method). Unset = checkout refused, webhook 503.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# Scheduled jobs (Vercel Cron): the alert pass (/api/alerts/run, every 5 minutes)
# and forecast resolution (/api/ledger/resolve, hourly). Both routes refuse every
# request until this is set; Vercel sends it as a bearer token. /api/health
# answers 503 when either job misses its schedule.
# CRON_SECRET=
