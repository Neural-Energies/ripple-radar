# Optional. Without it, "Analyze this event" uses the local engine (composeFromText).
XAI_API_KEY=

# Optional. FRED+ALFRED delayed macro (CPIAUCSL, UNRATE, VIXCLS, DCOILWTICO, T10Y2Y, DGS10).
# Without it, the desk skips official-stat series (empty bundle, no throw) and stays on RSS + Yahoo.
# Request a key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Auth + durable desk sync (Better Auth + Postgres). Leave unset for local/PWA demo.
# DATABASE_URL=postgres://user:pass@host/db
# BETTER_AUTH_SECRET=
# VITE_AUTH_ENABLED=true
